* text=auto

# Unity YAML assets should remain mergeable text.
*.meta text
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf

# Large binary game content belongs in Git LFS.
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.osz filter=lfs diff=lfs merge=lfs -text

# Imported audio is intentionally kept as TextAsset-compatible raw bytes while preserving the
# codec in the double extension. Match the final .bytes suffix explicitly so these binaries do
# not bypass the codec rules above.
*.wav.bytes filter=lfs diff=lfs merge=lfs -text
*.mp3.bytes filter=lfs diff=lfs merge=lfs -text
*.ogg.bytes filter=lfs diff=lfs merge=lfs -text
*.flac.bytes filter=lfs diff=lfs merge=lfs -text

# TMP font assets carry their glyph atlas inline; they are megabytes of generated YAML that
# nothing gains from diffing, so they go to LFS even though .asset normally stays mergeable text.
Assets/Game/UI/Fonts/TMP/*.asset filter=lfs diff=lfs merge=lfs -text

